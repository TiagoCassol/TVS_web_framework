# Fonte de dados do frontend:
#   mock -> adaptador em memória (não precisa do backend rodando)
#   http -> adaptador HTTP que chama a Minimal API
VITE_API_MODE=mock

# Base das URLs da API. Vazio = mesma origem (usa o proxy do Vite em dev).
VITE_API_URL=

# Para onde o proxy do Vite repassa /api em desenvolvimento.
VITE_PROXY_TARGET=http://localhost:5289
